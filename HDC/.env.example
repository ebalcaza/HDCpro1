# Copiá este archivo como .env y completá los valores.

# SQL Server (contenedor). La contraseña debe tener 8+ caracteres con mayúsculas, minúsculas,
# números y símbolos. No uses ";" porque rompe la cadena de conexión.
DB_SA_PASSWORD=CambiarEsta_Clave2026!
DB_NAME=HuellaCarbono
DB_PORT=14330

# JWT: clave de al menos 32 caracteres
JWT_CLAVE=reemplazar-por-una-clave-larga-y-aleatoria-de-32+caracteres
JWT_EXPIRA_MINUTOS=120

# Administrador inicial (se crea solo la primera vez)
ADMIN_EMAIL=admin@hdc.com
ADMIN_CONTRASENA=Admin2026!

# Puertos publicados en el host
API_PORT=5000
FRONTEND_PORT=8080
