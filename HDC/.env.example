# Copiá este archivo como .env y completá los valores.
# Las variables están explicadas en docs/GUIA_DESARROLLADOR.md (sección "Variables de entorno").

# --- Base de datos PostgreSQL (contenedor "db") ---
DB_USUARIO=hdc
# No uses ";" en la contraseña porque rompe la cadena de conexión
DB_CONTRASENA=CambiarEsta_Clave2026
DB_NAME=huellacarbono
# Puerto publicado SOLO en esta PC (para pgAdmin/DBeaver). 5433 para no chocar con un PostgreSQL instalado.
DB_PORT=5433

# --- JWT: clave de al menos 32 caracteres ---
JWT_CLAVE=reemplazar-por-una-clave-larga-y-aleatoria-de-32+caracteres
JWT_EXPIRA_MINUTOS=120

# --- Administrador inicial (se crea solo la primera vez) ---
ADMIN_EMAIL=admin@hdc.com
ADMIN_CONTRASENA=Admin2026!

# --- Datos de prueba (usuarios, domicilios y 12 meses de consumos) ---
# true = se cargan al arrancar si todavía no existen. En PRODUCCIÓN dejar en false.
DATOS_PRUEBA=true

# --- Email (SMTP) para la recuperación de contraseña ---
# Desarrollo: Mailpit (incluido en docker-compose) atrapa los emails; se ven en http://localhost:8025
# Producción: datos del proveedor SMTP (Brevo, Amazon SES, Mailgun, servidor institucional...)
SMTP_HOST=mailpit
SMTP_PUERTO=1025
SMTP_USUARIO=
SMTP_CONTRASENA=
# Ninguna (Mailpit) | StartTls (puerto 587, lo más común) | SslOnConnect (puerto 465)
SMTP_SEGURIDAD=Ninguna
EMAIL_REMITENTE=no-responder@hdc.local
EMAIL_NOMBRE_REMITENTE=Huella de Carbono

# --- Recuperación de contraseña ---
# Dirección pública del sistema: se usa para armar el link que llega por email
URL_PUBLICA=http://localhost:8081
# Minutos de validez del link
RECUPERACION_MINUTOS=30

# --- Puertos publicados en el host ---
API_PORT=5000
FRONTEND_PORT=8081
MAILPIT_PORT=8025
# Swagger (documentación interactiva de la API en /swagger). En producción: false
SWAGGER=true
